# Copie para .env.local — nunca commitar

# ── App ─────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ── Slack (testes locais — Incoming Webhooks) ───────────
# Não misturar com SignalHub / ForgeOps / VPS.
SLACK_WEBHOOK_NOVOS_CASOS=
# Opcional — alerta de corpus após motor Python / sync (fallback: NOVOS_CASOS)
SLACK_WEBHOOK_CORPUS=
# Opcional — erros de ops em testes
SLACK_WEBHOOK_ERROS=
# Opcional — POST JSON para o bot de captação após gravar corpus.json
SIGNALHUB_CAPTACAO_URL=

# ── Telegram (legado — contact/pagamento; opcional) ─────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CourtListener (Etapa 2 — corpus de opiniões) ────────
# Token: https://www.courtlistener.com/profile/api/
# Sem token, o site não chama a API (células ficam aguardando_corpus).
COURTLISTENER_API_TOKEN=

# ── Admin local (Etapa 3) ───────────────────────────────
# true = KPIs/receita com mock USD no localhost (sem SignalHub / DB prod)
# omitido = mock automático se Supabase service role ausente
ADMIN_LOCAL_MOCK=true

# ── Stripe (modo teste local — sk_test_ / pk_test_) ─────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# Webhook B2C: POST /api/webhooks/stripe  (evento checkout.session.completed)
# Local: stripe listen --forward-to localhost:3010/api/webhooks/stripe
# Cole o whsec_... impresso pelo CLI:
STRIPE_WEBHOOK_SECRET=whsec_...

# Payment Links (fallback se Sessions API indisponivel)
STRIPE_LINK_ESSENCIAL=https://buy.stripe.com/xxx
STRIPE_LINK_PADRAO=https://buy.stripe.com/xxx
STRIPE_LINK_COMPLETO=https://buy.stripe.com/xxx

# ── Supabase (região EU — wqkxvmmjekgdlcxsmdox) ────────
NEXT_PUBLIC_APP_URL=https://www.direitosconsumidor.com
NEXT_PUBLIC_SUPABASE_URL=https://wqkxvmmjekgdlcxsmdox.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_URL=https://wqkxvmmjekgdlcxsmdox.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
SUPABASE_ANON_KEY=sb_publishable_...

# ── Focus NFe (emissão interna MEI — nunca exposta ao consumidor PT) ──
FOCUS_NFE_AUTO=false
FOCUS_NFE_TOKEN=
FOCUS_NFE_HOMOLOGACAO=true
MEI_CNPJ=61.699.939/0001-80
INSCRICAO_MUNICIPAL=
MEI_CODIGO_MUNICIPIO=3510500
NFSE_ITEM_LISTA=17.01
NFSE_ALIQUOTA_ISS=2.84

# ── Admin (/admin/financeiro, /admin/relatorios) ───────
ADMIN_SECRET=escolha-uma-palavra-passe-forte
# Vários admins: separar por vírgula (OAuth Google + alertas de relatório)
ADMIN_EMAIL=contato.lexrocha@gmail.com,globemarket7@gmail.com

# ── Login Google (admin) — OAuth 2.0 ───────────────────
# Console: APIs & Services → Credentials → OAuth client (Web)
# Supabase → Authentication → URL Configuration → Redirect URLs:
#   https://www.direitosconsumidor.com/auth/callback
#   http://localhost:3010/auth/callback
# Google Cloud → redirect URI do provider Supabase:
#   https://wqkxvmmjekgdlcxsmdox.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Triagem de planos + relatórios (Groq) ─────────────
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Envio de relatórios ao cliente (Resend) ────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Direitos do Consumidor <contato.lexrocha@gmail.com>

# ── WhatsApp ────────────────────────────────────────────
WHATSAPP_URL=
