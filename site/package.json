  "private": true,
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "dev": "next dev -p 3010",
    "dev:fresh": "npm run clean && next dev -p 3010",
    "build": "next build",
    "start": "next start -p 3010",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:regressao-pipeline": "vitest run src/lib/pipeline-confiavel/regressao-massa.test.ts",
    "test:pipeline": "vitest run src/lib/pipeline-confiavel",
    "checklist:conferencia": "node ../scripts/checklist-conferencia-humana.mjs",
    "test:integracao": "node ../scripts/test-integracao.mjs",
    "test:copy": "node ../scripts/test-copy-audit.mjs",
    "test:copy:estrutura": "node ../scripts/test-copy-estrutura.mjs",
    "test:copy:all": "node ../scripts/test-copy-audit.mjs && node ../scripts/test-copy-estrutura.mjs",
    "test:all": "node ../scripts/test-all.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.98.0",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/ssr": "^0.12.0",
