# Copy to .env.local at root (DO NOT commit)
# Then run: .\scripts\sincronizar-env.ps1

# --- Site / Vercel (site/ folder) ---
NEXT_PUBLIC_APP_URL=https://www.judicialintelligence.com
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-side Supabase client (getSupabase) reads these — required for /api/checkout + webhook
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# --- Stripe (Checkout USD, en-US) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Site: WhatsApp + Telegram alerts (Vercel server env) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=15551234567
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_VERIFY_TOKEN=lex_us_verify_token
PAGAMENTO_WEBHOOK_SECRET=
AGENDA_DISPONIVEL=true

# --- Bot USA (signalhub/usa/.env folder) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_REVISAO=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_USERNAME=notificacoes_servico_bot

REDDIT_SUBREDDITS=legaladvice,ConsumerAdvice,personalfinance,Scams
REDDIT_LIMIT=20
SCAN_INTERVAL_SECONDS=300
MAX_ALERTAS_POR_HORA=20

# --- VPS 24/7 (optional - for .\scripts\DEPLOY_VPS.ps1) ---
VPS_SSH_HOST=
VPS_SSH_USER=root

# --- Groq (site report generation) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
