# Copie para .env.local na raiz ou em site/ — nunca commitar secrets

# ── App local (Next.js em site/ → porta 3010) ───────────
NEXT_PUBLIC_APP_URL=http://localhost:3010

# ── Slack (testes locais — Incoming Webhooks) ───────────
# Não misturar com SignalHub / ForgeOps / VPS.
SLACK_WEBHOOK_NOVOS_CASOS=
# Opcional — erros de ops em testes
SLACK_WEBHOOK_ERROS=

# ── Telegram (legado — contact/pagamento; opcional em paralelo) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── CourtListener (Etapa 2) ─────────────────────────────
COURTLISTENER_API_TOKEN=

# ── Admin local (Etapa 3) ───────────────────────────────
ADMIN_LOCAL_MOCK=true
